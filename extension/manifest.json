{
  "manifest_version": 3,
  "name": "Night Reader poster",
  "version": "0.19.0",
  "description": "Posts finished chapters from Night Reader to meiko.studio, inside your own logged-in browser.",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://meiko.studio/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meiko.studio/*"
      ],
      "js": [
        "netlog.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://meiko.studio/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
