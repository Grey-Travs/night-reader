# Secrets / OAuth — never commit
client_secret*.json
token.json
.env
# Holds the access key for reaching this app from a phone (see server/remote.py). It is
# created only when that is switched on, which is exactly why it has to be listed before
# then rather than after.
remote.json
# The Telegram bot's token and who is paired with it, and how far its messages have been
# taken in (see server/telegram_bot.py). The token is the key to the bot.
telegram.json
telegram_state.json
# The Activity page's settings (notices, the low-memory hold) and recent chapter times
# (see server/activity.py). Personal, not source.
activity.json

# Personal config (holds your settings; copy from config.example.toml)
config.toml

# Your translated novels & progress (per-user data)
projects/
series/
# The studio's own list of your novels, pushed here by the extension. Same reasoning as
# projects/ and series/: it is your library, not this app's source.
site_series.json
chapters/
audit/
glossary.json
glossary.md
glossary_pending.json
state.json
full-novel.md

# Error tracebacks written by the server (breadcrumbs for diagnosing, not source)
logs/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Web
web/node_modules/
web/dist/

# OS / editor / local tooling
.DS_Store
.claude/
.vscode/
.idea/
